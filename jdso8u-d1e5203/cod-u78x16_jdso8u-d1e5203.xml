      <div xml:id="jdso8u-d1e5203"><!-- jdso8u-b4d2prae -->
        <head>Praeambulum</head>
        <!-- <div alias="scotus-d2prae"> -->
          <p>
            <pb ed="#V" n="238"/>
            <cb ed="#V" n="a"/>
            <lb ed="#V" n="1" type="fixed=238"/>In prima distinctione egit
            Magi<lb ed="#V" n="2" break="no"/>ster de Sacramento legis Mosaicae
            <lb ed="#V" n="3"/>et legis naturae; in hac secunda
            <lb ed="#V" n="4"/>distinctione incipit agere de
            Sa<lb ed="#V" n="5" break="no"/>cramentis novae legis. Haec pars
            <lb ed="#V" n="6"/>dividitur in duas partes. Primo
            <lb ed="#V" n="7"/>namque determinat de eis
            conjun<lb ed="#V" n="8" break="no"/>ctim, secundo de singulis
            separa<lb ed="#V" n="9" break="no"/>tim ibi: Nunc vero de Baptismi.
            Pri<lb ed="#V" n="10" break="no"/>ma habet duas partes, secundum
            <lb ed="#V" n="11"/>quod primo determinat, quae et
            <lb ed="#V" n="12"/>quot sint Sacramenta novae legis;
            <lb ed="#V" n="13"/>secundo de tempore institutionis,
            <lb ed="#V" n="14"/>et efficacia eorumdem, ibi: Si
            <lb ed="#V" n="15"/>vero quaeritur.
          </p>
        <!--</div>-->
      </div>
    </body>
