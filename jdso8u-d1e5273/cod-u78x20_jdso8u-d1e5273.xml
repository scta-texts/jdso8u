      <div xml:id="jdso8u-d1e5273"><!-- jdso8u-b4d46prae -->
        <head xml:id="jdso8u-d1e5273-Hd1e99">Praeambulum</head>
        <!-- <div alias="scotus-d46prae"> -->
          <p xml:id="jdso8u-d1e5273-d1e103">
            <lb ed="#V" n="22" type="fixed=399"/>Sequitur hic de valde malis,
            <lb ed="#V" n="23"/>quia in hac distinctione agitur de
            <lb ed="#V" n="24"/>justitia Dei, et misericordia
            con<lb ed="#V" n="25" break="no"/>currentibus in punitione
            malo<lb ed="#V" n="26" break="no"/>rum. Ideo quaeruntur quatuor:
            <lb ed="#V" n="27"/>Primo, utrum in Deo sit justitia?
            <lb ed="#V" n="28"/>Secundo, utrum in Deo sit
            mise<lb ed="#V" n="29" break="no"/>ricordia? Tertio, an in Deo
            distin<lb ed="#V" n="30" break="no"/>guatur justitia et misericordia?
            <lb ed="#V" n="31"/>Quarto, an in punitione malorum
            <lb ed="#V" n="32"/>concurrat ex parte Dei punientis
            <lb ed="#V" n="33"/>justitia cum misericordia?
          </p>
        <!--</div>-->
      </div>
    </body>
