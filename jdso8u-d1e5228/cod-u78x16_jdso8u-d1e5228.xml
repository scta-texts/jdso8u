      <div xml:id="jdso8u-d1e5228"><!-- jdso8u-b4d7prae -->
        <head>Praeambulum</head>
        <!-- <div alias="scotus-d7prae"> -->
          <p>
            <lb ed="#V" n="19" type="fixed=656"/>Postquam Magister egit de
            pri<lb ed="#V" n="20" break="no"/>mo Sacramento, scilicet de
            Bapti<lb ed="#V" n="21" break="no"/>smo, hic agit de secundo, scilicet
            <lb ed="#V" n="22"/>de Sacramento Confirmationis. Et
            <lb ed="#V" n="23"/>dividitur in duas partes, scilicet
            <lb ed="#V" n="24"/>in Prooemium, et tractatum, qui
            <lb ed="#V" n="25"/>incipit ibi: Forma enim. Et ille
            tra<lb ed="#V" n="26" break="no"/>ctatus dividitur in quinque partes.
            <lb ed="#V" n="27"/>Primo namque determinat de
            for<lb ed="#V" n="28" break="no"/>ma Sacramenti. Secundo, de
            mi<lb ed="#V" n="29" break="no"/>nistro, ibi: Hoc Sacramentam ab aliis.
            <lb ed="#V" n="30"/>Tertio, de effectu, ibi: Virtus autem.
            <lb ed="#V" n="31"/>Quarto, de conditione quadam in
            <lb ed="#V" n="32"/>suscipiente et conferente,
            perti<lb ed="#V" n="33" break="no"/>nente ad reverentiam Sacramenti,
            <lb ed="#V" n="34"/>ibi: Hoc Sacramentum tantum a jejunis.
            <lb ed="#V" n="35"/>Quinto et ultimo, de
            initerabili<lb ed="#V" n="36" break="no"/>tate hujus Sacramenti, ibi: Nec
            de<lb ed="#V" n="37" break="no"/>bet iterari.
          </p>
        <!--</div>-->
      </div>
